    "inputs": [
      {
        "name": "noisy",
        "layout": "nchw",
        "dtype": "float32",
        "channels": 15,
        "dynamic_hw": true,
        "note": "5-frame patch concatenated on channels: [t-2|t-1|t|t+1|t+2] (RGB each)"
      },
      {
        "name": "noise_map",
        "layout": "nchw",
        "dtype": "float32",
        "channels": 1,
        "dynamic_hw": true,
