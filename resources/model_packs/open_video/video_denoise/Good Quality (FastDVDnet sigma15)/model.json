{
  "schema_version": 2,
  "id": "fastdvdnet_sigma15",
  "display_name": "FastDVDnet Video Denoise (sigma=15)",
  "task": "video_denoise",
  "files": [
    {
      "name": "model.onnx",
      "kind": "onnx",
      "role": "main",
      "sha256": "0895dcad878f44ff4b610e0569bf701c8e23566e675c22a9bb0d59b95dcfc7ac"
    }
  ],
  "onnx": {
    "main": "model.onnx",
    "inputs": [
      {
        "name": "noisy",
        "layout": "nchw",
        "dtype": "float32",
        "channels": 15,
        "dynamic_hw": true,
        "note": "5-frame patch concatenated on channels: [t-2|t-1|t|t+1|t+2] (RGB each)"
      },
      {
        "name": "noise_map",
        "layout": "nchw",
        "dtype": "float32",
        "channels": 1,
        "dynamic_hw": true,
        "note": "Noise std map in [0..1]. For fixed sigma, fill with sigma/255 everywhere. Trained for sigma in [5,55]."
      }
    ],
    "outputs": [
      {
        "name": "denoised",
        "kind": "rgb",
        "dtype": "float32",
        "channels": 3,
        "dynamic_hw": true
      }
    ],
    "preprocess": {
      "color": "rgb",
      "range": "0..1"
    },
    "postprocess": {
      "clamp": [
        0.0,
        1.0
      ]
    }
  },
  "runtime_hints": {
    "preferred_execution_provider": "auto",
    "default_sigma": 15,
    "note": "FastDVDnet supports a range of noise levels; this pack represents a mild sigma preset."
  },
  "origin": {
    "upstream_repo": "https://github.com/m-tassano/fastdvdnet",
    "paper": "https://arxiv.org/abs/1907.01361",
    "license": "MIT",
    "notes": "Self-contained opset-17 FP32 export of verified upstream model.pth; scripts/models/export_fastdvdnet.py. Dynamic N/H/W; H/W multiples of four.",
    "upstream_commit": "c8fdf6182a0340e89dd18f5df25b47337cbede6f",
    "weights_sha256": "9d9d8413c33e3d9d961d07c530237befa1197610b9d60602ff42fd77975d2a17"
  }
}
