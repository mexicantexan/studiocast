const uint grid_y[48]=uint[48](3212836864u,3212122940u,3211409016u,3210695092u,3209981168u,3209267244u,3208553320u,3207839396u,3207125472u,3206411548u,3205697624u,3204983700u,3204091294u,3202663446u,3201235598u,3199807750u,3198379902u,3196952054u,3194988764u,3192133068u,3189277372u,3185172312u,3179460920u,3165539424u,1018055744u,1031977264u,1037688656u,1041793720u,1044649416u,1047505112u,1049468404u,1050896252u,1052324100u,1053751948u,1055179796u,1056607644u,1057500050u,1058213974u,1058927898u,1059641822u,1060355746u,1061069670u,1061783594u,1062497518u,1063211442u,1063925366u,1064639290u,1065353216u);

uint tid() { return gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64; }
uint byte1(float v) { return uint(clamp(floor(clamp(v,0.,255.)+.5),0.,255.)); }
float channel(uint v,uint c) { return float((v>>(c*8))&255u); }
float mark(uint i) { return uintBitsToFloat(b1[i]); }
float sf(uint i) { return uintBitsToFloat(st[i]); }
float geometry_div(float a,float b) {
 precise float quotient=a/b;
 precise float residual=fma(-quotient,b,a);
 precise float result=fma(residual,1./b,quotient);
 return result;
}
float sample_frame(float x,float y,uint c) {
 x=clamp(x,0.,float(p[1]-1));y=clamp(y,0.,float(p[2]-1));
 uint x0=uint(floor(x)),y0=uint(floor(y)),x1=min(p[1]-1,x0+1),y1=min(p[2]-1,y0+1);
 float fx=x-float(x0),fy=y-float(y0);
 precise float a=channel(b0[y0*p[3]+x0],c)*(1.-fx)+channel(b0[y0*p[3]+x1],c)*fx;
 precise float b=channel(b0[y1*p[3]+x0],c)*(1.-fx)+channel(b0[y1*p[3]+x1],c)*fx;
 precise float result=a*(1.-fy)+b*fy;
 return result;
}
vec4 geometry(uint eye) {
 uint base=eye==0?42u:36u;
 precise float cx=(mark(base*2)+mark((base+3)*2))*.5;
 precise float cy=(mark(base*2+1)+mark((base+3)*2+1))*.5;
 precise float halfw=abs(mark((base+3)*2)-mark(base*2))*.75,boxh=1.5*halfw;
 int left=clamp(int(floor(cx-halfw)),0,int(p[1])-2);
 int right=clamp(int(ceil(cx+halfw)),1,int(p[1])-1);
 int top=clamp(int(floor(cy-boxh*(7./12.))),0,int(p[2])-2);
 int bottom=clamp(int(ceil(cy+boxh*(5./12.))),1,int(p[2])-1);
 return vec4(left,top,max(1,right-left),max(1,bottom-top));
}
float corrected(uint eye,uint index) { return uintBitsToFloat(eye==0?b1[index]:b2[index]); }
float sample_corrected(uint eye,uint c,float x,float y) {
 x=clamp(x,0.,63.);y=clamp(y,0.,47.);
 uint x0=uint(floor(x)),y0=uint(floor(y)),x1=min(63u,x0+1),y1=min(47u,y0+1);
 float fx=x-float(x0),fy=y-float(y0);uint plane=c*3072;
 precise float a=float(byte1(clamp(corrected(eye,plane+y0*64+x0),0.,1.)*255.))*(1.-fx)+float(byte1(clamp(corrected(eye,plane+y0*64+x1),0.,1.)*255.))*fx;
 precise float b=float(byte1(clamp(corrected(eye,plane+y1*64+x0),0.,1.)*255.))*(1.-fx)+float(byte1(clamp(corrected(eye,plane+y1*64+x1),0.,1.)*255.))*fx;
 precise float result=a*(1.-fy)+b*fy;
 return result;
}
void main() {
 uint i=tid(),op=p[0];
 if(op==0) {
   uint eye=p[5],base=eye==0?42u:36u;
   vec4 g=vec4(0,0,1,1);
   bool valid=st[8]!=0&&st[5]!=0;
   if(valid)g=geometry(eye);
   if(i<4)st[60+eye*5+i]=floatBitsToUint(g[i]);
   if(i==0)st[64+eye*5]=uint(valid&&g.z>=2.&&g.w>=2.);
   if(i<9216) {
     uint c=i/3072,q=i%3072,x=q%64,y=q/64;
     float sx=clamp(g.x+(float(x)+.5)*g.z/64.-.5,g.x,g.x+g.z-1.);
     float sy=clamp(g.y+(float(y)+.5)*g.w/48.-.5,g.y,g.y+g.w-1.);
     b2[i]=floatBitsToUint(valid?float(byte1(sample_frame(sx,sy,c)))/255.:0.);
   }
   if(i<36864) {
     uint c=i/3072,q=i%3072,x=q%64,y=q/64;
     const uint order[6]=uint[6](3,2,1,0,5,4);
     uint point=base+(eye==0?order[c/2]:c/2);
     int rx=valid?int(floor(geometry_div((mark(2*point)-g.x)*64.,g.z)+.5)):0;
     int ry=valid?int(floor(geometry_div((mark(2*point+1)-g.y)*48.,g.w)+.5)):0;
     b3[i]=floatBitsToUint(valid?float((c&1u)!=0?int(y)-ry:int(x)-rx):0.);
   }
   if(i==0){b4[0]=floatBitsToUint(0.);b4[1]=floatBitsToUint(-.10*uintBitsToFloat(p[6]));}
   return;
 }
 if(op==1) {
   if(i>=9216)return;
   uint c=i/3072,q=i%3072,x=q%64,y=q/64;
   if(st[8]==0||st[5]==0){b3[i]=0;return;}
   precise float nx=uintBitsToFloat(b1[q])+uintBitsToFloat(grid_x[x]);
   precise float ny=uintBitsToFloat(b1[3072+q])+uintBitsToFloat(grid_y[y]);
   precise float px=(nx+1.)*32.,py=(ny+1.)*24.;
   int ix=int(floor(px)),iy=int(floor(py));
   int x0=clamp(ix,0,63),x1=clamp(ix+1,0,63),y0=clamp(iy,0,47),y1=clamp(iy+1,0,47);
   // Original FLX clips BOTH indices before calculating interpolation weights.
   // Replacing this with clamped bilinear sampling changes border semantics.
   precise float wa=(float(x1)-px)*(float(y1)-py);
   precise float wb=(float(x1)-px)*(py-float(y0));
   precise float wc=(px-float(x0))*(float(y1)-py);
   precise float wd=(px-float(x0))*(py-float(y0));
   precise float value=wa*uintBitsToFloat(b0[c*3072+uint(y0*64+x0)]);
   value=value+wb*uintBitsToFloat(b0[c*3072+uint(y1*64+x0)]);
   value=value+wc*uintBitsToFloat(b0[c*3072+uint(y0*64+x1)]);
   value=value+wd*uintBitsToFloat(b0[c*3072+uint(y1*64+x1)]);
   precise float output_value=value*uintBitsToFloat(b2[q])+uintBitsToFloat(b2[3072+q]);
   b3[i]=floatBitsToUint(output_value);return;
 }
 if(op==2) {
   if(i>=p[1]*p[2])return;
   uint x=i%p[1],y=i/p[1],src=b0[y*p[3]+x],out_value=0xff000000u;
   float strength=uintBitsToFloat(p[6]);
   for(uint c=0;c<3;c++) {
     uint value=(src>>(c*8))&255u;
     for(uint eye=0;eye<2;eye++) {
       uint o=60+eye*5;
       vec4 g=vec4(sf(o),sf(o+1),sf(o+2),sf(o+3));
       if(st[o+4]==0||float(x)<g.x||float(y)<g.y||float(x)>=g.x+g.z||float(y)>=g.y+g.w||strength<=0.)continue;
       precise float mx=geometry_div((float(x)-g.x+.5)*64.,g.z)-.5,my=geometry_div((float(y)-g.y+.5)*48.,g.w)-.5;
       float corrected_byte=float(byte1(sample_corrected(eye,c,mx,my)));
       precise float mixed=float(value)+(corrected_byte-float(value))*strength;
       value=byte1(mixed);
     }
     out_value|=value<<(c*8);
   }
   b3[y*p[4]+x]=out_value;return;
 }
