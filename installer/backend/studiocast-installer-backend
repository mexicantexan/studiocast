EOF
}

print_os_json() {
  read_os_release
  printf '{'
  printf '"pretty_name":'; json_string "${OS_PRETTY_NAME}"; printf ','
  printf '"id":'; json_string "${OS_ID}"; printf ','
  printf '"version_id":'; json_string "${OS_VERSION_ID}"; printf ','
  printf '"version_codename":'; json_string "${OS_VERSION_CODENAME}"; printf ','
  printf '"ubuntu_codename":'; json_string "${OS_UBUNTU_CODENAME}"; printf ','
  printf '"id_like":'; json_string "${OS_ID_LIKE}"; printf ','
  printf '"base_id":'; json_string "${OS_BASE_ID}"; printf ','
  printf '"base_version_id":'; json_string "${OS_BASE_VERSION_ID}"; printf ','
  printf '"base_codename":'; json_string "${OS_BASE_CODENAME}"; printf ','
  printf '"supported":'; json_bool "${OS_SUPPORTED}"; printf ','
  printf '"support_reason":'; json_string "${OS_SUPPORT_REASON}"; printf ','
  printf '"mapping_note":'; json_string "${OS_MAPPING_NOTE}"
  printf '}\n'
}

service_state_value() {
  local mode="$1"
  if ! have_cmd systemctl; then
    printf 'systemctl-unavailable'
    return 0
  fi
  local value
  value="$(systemctl --user "${mode}" "${SERVICE_NAME}" 2>/dev/null || true)"
  if [[ -z "${value}" ]]; then
    value="unknown"
  fi
  printf '%s' "${value}"
}

onnxruntime_library_dirs() {
  local d
  if have_cmd pkg-config && pkg-config --exists onnxruntime; then
    d="$(pkg-config --variable=libdir onnxruntime 2>/dev/null || true)"
    [[ -n "${d}" ]] && printf '%s\n' "${d}"
    pkg-config --libs-only-L onnxruntime 2>/dev/null | tr ' ' '\n' |
      sed -n 's/^-L//p'
  fi

  printf '%s\n' \
    /usr/local/lib \
    /usr/lib \
    /usr/lib/x86_64-linux-gnu \
    /opt/studiocast/onnxruntime/*/onnxruntime-linux-*/lib
}

detect_onnxruntime_cuda_provider_path() {
  local d provider
  while IFS= read -r d; do
    [[ -n "${d}" ]] || continue
    for provider in "${d}/libonnxruntime_providers_cuda.so"; do
      if [[ -f "${provider}" ]]; then
        printf '%s\n' "${provider}"
        return 0
      fi
    done
  done < <(onnxruntime_library_dirs | awk '!seen[$0]++')
  return 1
}

detect_vulkan_loader_path() {
  if have_cmd ldconfig; then
    local from_ldconfig
    from_ldconfig="$(ldconfig -p 2>/dev/null | awk '/libvulkan[.]so[.]1/ {print $NF; exit}')"
    if [[ -n "${from_ldconfig}" ]]; then
      printf '%s\n' "${from_ldconfig}"
      return 0
    fi
  fi

  local candidate
  for candidate in \
    /usr/lib/libvulkan.so.1 \
    /usr/lib64/libvulkan.so.1 \
    /usr/lib/x86_64-linux-gnu/libvulkan.so.1 \
    /lib/x86_64-linux-gnu/libvulkan.so.1; do
    if [[ -e "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

detect_maxine_base_dir() {
  printf '%s\n' "${XDG_DATA_HOME_DIR}/${APP_ID}/maxine"
}

print_optional_components_json() {
  local cuda_available=0 cuda_summary cuda_details
  if have_cmd nvidia-smi; then
    if cuda_details="$(nvidia-smi -L 2>&1)" && [[ -n "${cuda_details}" ]]; then
      cuda_available=1
      cuda_summary="NVIDIA driver/GPU detected with nvidia-smi."
    else
      cuda_details="${cuda_details:-nvidia-smi did not report a GPU.}"
      cuda_summary="NVIDIA CUDA driver/GPU was not detected."
    fi
  else
    cuda_details="nvidia-smi was not found."
    cuda_summary="NVIDIA CUDA driver/GPU was not detected."
  fi

  local ort_present=0 ort_version="" ort_cuda_provider=0 ort_provider_path=""
  if have_cmd pkg-config && pkg-config --exists onnxruntime; then
    ort_present=1
    ort_version="$(pkg-config --modversion onnxruntime 2>/dev/null || true)"
  elif have_cmd ldconfig && ldconfig -p 2>/dev/null | grep -q 'libonnxruntime\.so'; then
    ort_present=1
    ort_version="found-via-ldconfig"
  fi
  if ort_provider_path="$(detect_onnxruntime_cuda_provider_path 2>/dev/null || true)" &&
     [[ -n "${ort_provider_path}" ]]; then
    ort_cuda_provider=1
  fi

  local maxine_base vfx_root ar_root afx_root
  local maxine_vfx=0 maxine_ar=0 maxine_afx=0 maxine_complete=0
  maxine_base="$(detect_maxine_base_dir)"
  vfx_root="${maxine_base}/VideoFX"
  ar_root="${maxine_base}/ARSDK"
  afx_root="${maxine_base}/Audio_Effects_SDK"
  [[ -d "${vfx_root}" ]] && maxine_vfx=1
  [[ -d "${ar_root}" ]] && maxine_ar=1
  [[ -d "${afx_root}" ]] && maxine_afx=1
  [[ "${maxine_vfx}" -eq 1 && "${maxine_ar}" -eq 1 && "${maxine_afx}" -eq 1 ]] && maxine_complete=1

  local vulkan_loader=0 vulkan_loader_path="" vulkaninfo_present=0
  if vulkan_loader_path="$(detect_vulkan_loader_path 2>/dev/null || true)" &&
     [[ -n "${vulkan_loader_path}" ]]; then
    vulkan_loader=1
  fi
  if have_cmd vulkaninfo; then
    vulkaninfo_present=1
  fi

  printf '{'
  printf '"cuda":{'
  printf '"available":'; json_bool "${cuda_available}"; printf ','
  printf '"summary":'; json_string "${cuda_summary}"; printf ','
  printf '"details":'; json_string "${cuda_details}"; printf ','
  printf '"install_docs":'; json_string "docs/open_source_video_models_install.md"
  printf '},'
  printf '"onnxruntime_cuda":{'
  printf '"present":'; json_bool "${ort_present}"; printf ','
  printf '"version":'; json_string "${ort_version}"; printf ','
  printf '"cuda_provider_present":'; json_bool "${ort_cuda_provider}"; printf ','
  printf '"cuda_provider_path":'; json_string "${ort_provider_path}"; printf ','
  printf '"install_docs":'; json_string "docs/open_source_video_models_install.md"
  printf '},'
  printf '"maxine_sdk":{'
  printf '"complete":'; json_bool "${maxine_complete}"; printf ','
  printf '"base_dir":'; json_string "${maxine_base}"; printf ','
  printf '"vfx_present":'; json_bool "${maxine_vfx}"; printf ','
  printf '"ar_present":'; json_bool "${maxine_ar}"; printf ','
  printf '"afx_present":'; json_bool "${maxine_afx}"; printf ','
  printf '"install_docs":'; json_string "docs/maxine_install.md"
  printf '},'
  printf '"vulkan":{'
  printf '"loader_present":'; json_bool "${vulkan_loader}"; printf ','
  printf '"loader_path":'; json_string "${vulkan_loader_path}"; printf ','
  printf '"vulkaninfo_present":'; json_bool "${vulkaninfo_present}"; printf ','
  printf '"runtime_packages":'; json_string_array "libvulkan1" "vulkan-tools"; printf ','
  printf '"mesa_icd_package":'; json_string "mesa-vulkan-drivers"; printf ','
  printf '"shader_tools_package":'; json_string "glslang-tools"; printf ','
  printf '"summary":'; json_string "Optional Vulkan packages provide the loader and diagnostics only; Open Vulkan also requires -DSTUDIOCAST_ENABLE_OPEN_VULKAN=ON plus a GPU driver/ICD exposing a compute-capable device."; printf ','
  printf '"install_docs":'; json_string "docs/SETUP.md"
  printf '}'
  printf '}'
}

print_status_human() {
  local project_version installed_version manifest_state active enabled
  project_version="$(project_version_from "${REPO_ROOT}")"
  installed_version="$(installed_binary_version)"
  if [[ -z "${installed_version}" ]]; then
    installed_version="$(manifest_field installed_version 2>/dev/null || true)"
  fi
  manifest_state="$(manifest_field state 2>/dev/null || true)"
  active="$(service_state_value is-active)"
  enabled="$(service_state_value is-enabled)"

  cat <<EOF
Project version: ${project_version}
Installed version: ${installed_version:-not installed}
Manifest: ${MANIFEST_PATH}$([[ -f "${MANIFEST_PATH}" ]] && echo " (present)" || echo " (missing)")
Manifest state: ${manifest_state:-unknown}
Local bin: ${LOCAL_BIN_DIR}
User service: ${SERVICE_PATH}$([[ -f "${SERVICE_PATH}" ]] && echo " (present)" || echo " (missing)")
Service active: ${active}
Service enabled: ${enabled}
EOF
}

print_status_json() {
  read_os_release
  local project_version installed_version manifest_state active enabled installed
  project_version="$(project_version_from "${REPO_ROOT}")"
  installed_version="$(installed_binary_version)"
  if [[ -z "${installed_version}" ]]; then
    installed_version="$(manifest_field installed_version 2>/dev/null || true)"
  fi
  manifest_state="$(manifest_field state 2>/dev/null || true)"
  active="$(service_state_value is-active)"
  enabled="$(service_state_value is-enabled)"
  installed=0
  if [[ -f "${MANIFEST_PATH}" && "${manifest_state}" != "uninstalled" && -x "${LOCAL_BIN_DIR}/studiocast" ]]; then
    installed=1
  fi

  printf '{'
  printf '"project_version":'; json_string "${project_version}"; printf ','
  printf '"installed":'; json_bool "${installed}"; printf ','
  printf '"installed_version":'; json_string "${installed_version:-}"; printf ','
  printf '"manifest_path":'; json_string "${MANIFEST_PATH}"; printf ','
  printf '"manifest_exists":'; json_bool "$([[ -f "${MANIFEST_PATH}" ]] && echo 1 || echo 0)"; printf ','
  printf '"manifest_state":'; json_string "${manifest_state:-}"; printf ','
  printf '"source_path":'; json_string "$(manifest_field source_path 2>/dev/null || true)"; printf ','
  printf '"build_path":'; json_string "$(manifest_field build_path 2>/dev/null || true)"; printf ','
  printf '"local_bin_dir":'; json_string "${LOCAL_BIN_DIR}"; printf ','
  printf '"service":{'
  printf '"path":'; json_string "${SERVICE_PATH}"; printf ','
  printf '"installed":'; json_bool "$([[ -f "${SERVICE_PATH}" ]] && echo 1 || echo 0)"; printf ','
  printf '"active":'; json_string "${active}"; printf ','
  printf '"enabled":'; json_string "${enabled}"
  printf '},'
  printf '"os":'
  print_os_json | tr -d '\n'
  printf ','
  printf '"binaries":['
  local first=1 b path
  for b in "${BINARIES[@]}"; do
    path="${LOCAL_BIN_DIR}/${b}"
    if [[ "${first}" -eq 0 ]]; then
      printf ','
    fi
    first=0
    printf '{'
    printf '"name":'; json_string "${b}"; printf ','
    printf '"path":'; json_string "${path}"; printf ','
    printf '"exists":'; json_bool "$([[ -e "${path}" || -L "${path}" ]] && echo 1 || echo 0)"; printf ','
    printf '"executable":'; json_bool "$([[ -x "${path}" ]] && echo 1 || echo 0)"
    printf '}'
  done
  printf '],'
  printf '"optional_components":'
  print_optional_components_json
  printf '}\n'
}

archive_version() {
  local archive="$1"
  local member=""
  case "${archive}" in
    *.zip)
      have_cmd unzip || { printf 'unknown'; return 0; }
      member="$(unzip -Z1 "${archive}" 2>/dev/null | awk '(^$0 == "VERSION" || $0 ~ /\/VERSION$/) {print; exit}')"
      if [[ -n "${member}" ]]; then
        unzip -p "${archive}" "${member}" 2>/dev/null | tr -d '[:space:]' || true
      else
        printf 'unknown'
      fi
      ;;
    *.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2|*.tbz2)
      have_cmd tar || { printf 'unknown'; return 0; }
      member="$(tar -tf "${archive}" 2>/dev/null | awk '(^$0 == "VERSION" || $0 ~ /\/VERSION$/) {print; exit}')"
      if [[ -n "${member}" ]]; then
        tar -xOf "${archive}" "${member}" 2>/dev/null | tr -d '[:space:]' || true
      else
        printf 'unknown'
      fi
      ;;
    *)
      printf 'unknown'
      ;;
  esac
}

PLAN_SUMMARY=()
PLAN_CHANGES=()
PLAN_PRIVILEGED=()
PLAN_PRESERVED=()
PLAN_REMOVED=()
PLAN_COMMANDS=()

reset_plan() {
  PLAN_SUMMARY=()
  PLAN_CHANGES=()
  PLAN_PRIVILEGED=()
  PLAN_PRESERVED=()
  PLAN_REMOVED=()
  PLAN_COMMANDS=()
}

add_plan_command() {
  local rendered
  rendered="$(printf '%q ' "$@")"
  PLAN_COMMANDS+=("${rendered% }")
}

plan_workflow() {
  reset_plan
  read_os_release

  local current_version target_version source_label
  local plan_source_dir
  current_version="$(installed_binary_version)"
  if [[ -z "${current_version}" ]]; then
    current_version="$(manifest_field installed_version 2>/dev/null || true)"
  fi

  if [[ -n "${RELEASE_ARCHIVE}" ]]; then
    target_version="$(archive_version "${RELEASE_ARCHIVE}")"
    source_label="${RELEASE_ARCHIVE}"
    plan_source_dir="<extracted source from ${RELEASE_ARCHIVE}>"
  else
    target_version="$(project_version_from "${SOURCE_DIR}")"
    source_label="${SOURCE_DIR}"
    plan_source_dir="${SOURCE_DIR}"
  fi

  PLAN_SUMMARY+=("Current installed version: ${current_version:-not installed}")
  if [[ "${WORKFLOW}" != "uninstall" ]]; then
    PLAN_SUMMARY+=("Detected OS: ${OS_PRETTY_NAME:-unknown}; ${OS_SUPPORT_REASON}")
    PLAN_SUMMARY+=("Target StudioCast version: ${target_version:-unknown}")
    PLAN_SUMMARY+=("Source: ${source_label}")
    PLAN_SUMMARY+=("Build directory: ${BUILD_DIR} (${BUILD_TYPE})")
  fi

  case "${WORKFLOW}" in
    install)
      PLAN_CHANGES+=("Install StudioCast binaries into ${LOCAL_BIN_DIR}.")
      PLAN_CHANGES+=("Configure and build StudioCast from the selected source.")
      ;;
    update)
      PLAN_CHANGES+=("Update StudioCast binaries in ${LOCAL_BIN_DIR} from selected source/archive.")
      PLAN_PRESERVED+=("User config, downloaded model packs, logs, and cache are preserved.")
      ;;
    repair)
      PLAN_CHANGES+=("Rebuild and reinstall the current StudioCast app binaries and service wiring.")
      PLAN_PRESERVED+=("User config, downloaded model packs, logs, and cache are preserved.")
      ;;
    uninstall)
      PLAN_CHANGES+=("Stop/disable the StudioCast user service and remove app symlinks from ${LOCAL_BIN_DIR}.")
      PLAN_REMOVED+=("${SERVICE_PATH}")
      PLAN_REMOVED+=("StudioCast symlinks in ${LOCAL_BIN_DIR}")
      if [[ "${REMOVE_USER_DATA}" -eq 1 ]]; then
        PLAN_REMOVED+=("${APP_DATA_DIR}")
        PLAN_REMOVED+=("${APP_CONFIG_DIR}")
        PLAN_REMOVED+=("${APP_STATE_DIR}")
        PLAN_REMOVED+=("${APP_CACHE_DIR}")
      else
        PLAN_PRESERVED+=("${APP_DATA_DIR} (manifest and downloaded model packs)")
        PLAN_PRESERVED+=("${APP_CONFIG_DIR} (user settings)")
        PLAN_PRESERVED+=("${APP_STATE_DIR} (logs/state)")
        PLAN_PRESERVED+=("${APP_CACHE_DIR} (build/cache)")
      fi
      ;;
    clean-install)
      PLAN_CHANGES+=("Remove app binaries/service/runtime artifacts, then install from selected source/archive.")
      PLAN_CHANGES+=("Configure and build StudioCast from the selected source.")
      PLAN_CHANGES+=("Install StudioCast binaries into ${LOCAL_BIN_DIR}.")
      PLAN_REMOVED+=("${SERVICE_PATH}")
      PLAN_REMOVED+=("StudioCast symlinks in ${LOCAL_BIN_DIR}")
      if [[ "${REMOVE_USER_DATA}" -eq 1 ]]; then
        PLAN_REMOVED+=("${APP_DATA_DIR}")
        PLAN_REMOVED+=("${APP_CONFIG_DIR}")
        PLAN_REMOVED+=("${APP_STATE_DIR}")
        PLAN_REMOVED+=("${APP_CACHE_DIR}")
      else
        PLAN_PRESERVED+=("User config, downloaded model packs, logs, and cache are preserved.")
      fi
      ;;
    advanced)
      PLAN_CHANGES+=("No changes are made by the advanced plan.")
      PLAN_CHANGES+=("Use the displayed backend commands for CI, SSH, recovery, or manual debugging.")
      ;;
    *)
      die "Unknown workflow: ${WORKFLOW}"
      ;;
  esac

  if [[ "${WORKFLOW}" != "uninstall" && "${WORKFLOW}" != "advanced" ]]; then
    if [[ "${WITH_DEPS}" -eq 1 ]]; then
      PLAN_CHANGES+=("Install/refresh build and runtime dependencies through scripts/setup.sh.")
      PLAN_PRIVILEGED+=("apt package operations and /opt/ldconfig writes delegated to scripts/setup.sh via sudo.")
    fi
    if [[ "${WITH_VULKAN_RUNTIME}" -eq 1 ]]; then
      PLAN_CHANGES+=("Install optional Vulkan loader/diagnostic packages; this does not guarantee Vulkan device support.")
      PLAN_PRIVILEGED+=("Vulkan package operations are delegated to scripts/setup.sh via sudo.")
    fi
    if [[ "${WITH_MESA_VULKAN}" -eq 1 ]]; then
      PLAN_CHANGES+=("Install Mesa Intel/AMD Vulkan ICD packages when available from the distro.")
    fi
    if [[ "${WITH_SHADER_TOOLS}" -eq 1 ]]; then
      PLAN_CHANGES+=("Install optional developer shader tools for validating/regenerating embedded Vulkan SPIR-V.")
    fi
    if [[ "${WITH_V4L2}" -eq 1 ]]; then
      PLAN_CHANGES+=("Ensure v4l2loopback is installed for the StudioCast virtual camera.")
      PLAN_PRIVILEGED+=("v4l2loopback package/module operations delegated to scripts/setup.sh via sudo.")
      if [[ "${LOAD_LOOPBACK}" -eq 1 ]]; then
        PLAN_CHANGES+=("Load the StudioCast v4l2loopback camera now.")
      fi
      if [[ "${PERSIST_LOOPBACK}" -eq 1 ]]; then
        PLAN_CHANGES+=("Persist the StudioCast v4l2loopback camera across reboot.")
      fi
    fi
    if [[ "${WITH_SERVICE}" -eq 1 ]]; then
      PLAN_CHANGES+=("Install and start ${SERVICE_NAME} as a systemd user service.")
    else
      PLAN_CHANGES+=("Install StudioCast binary symlinks only; do not install/start the user service.")
    fi
    if [[ "${WITH_MODELS}" -eq 1 ]]; then
      PLAN_CHANGES+=("Download/install default Open Audio and Open Video model packs.")
    else
      PLAN_PRESERVED+=("Maxine/NVIDIA SDK assets and model packs remain optional; missing SDKs do not block open-source build/install.")
    fi
    if [[ "${OPEN_BACKENDS}" -eq 1 ]]; then
      PLAN_CHANGES+=("Force Linux CMake configuration to keep Open Video/Open CUDA and Open Audio enabled.")
    fi
    if [[ "${OPEN_VULKAN}" -eq 1 ]]; then
      PLAN_CHANGES+=("Enable the optional, runtime-loaded Open Vulkan CMake backend.")
    fi
    if [[ "${OPEN_VULKAN}" -eq 1 || "${WITH_VULKAN_RUNTIME}" -eq 1 || "${WITH_MESA_VULKAN}" -eq 1 || "${WITH_SHADER_TOOLS}" -eq 1 ]]; then
      PLAN_CHANGES+=("Open Vulkan is optional and runtime-loaded, and still requires a working GPU driver/ICD exposing a compute-capable device; package/tool installation alone does not provide CUDA/NVIDIA effect parity.")
      PLAN_CHANGES+=("Production Open Vulkan virtual-background matting remains blocked until a device-resident Vulkan inference runtime is implemented.")
    fi
    PLAN_CHANGES+=("Enable CPU resize fallback in the daemon config by default.")
    PLAN_CHANGES+=("Write install manifest: ${MANIFEST_PATH}.")
  fi

  add_plan_command "${BACKEND_PATH}" detect-os
  add_plan_command "${BACKEND_PATH}" status
  case "${WORKFLOW}" in
    install|update|repair|clean-install)
      if [[ "${WITH_DEPS}" -eq 1 || "${WITH_VULKAN_RUNTIME}" -eq 1 || "${WITH_SHADER_TOOLS}" -eq 1 ]]; then
        local -a setup_args=()
        [[ "${WITH_DEPS}" -eq 1 ]] && setup_args+=("--deps")
        if [[ "${WITH_V4L2}" -eq 1 ]]; then
          setup_args+=("--v4l2loopback")
          [[ "${LOAD_LOOPBACK}" -eq 1 ]] && setup_args+=("--load-loopback")
          [[ "${PERSIST_LOOPBACK}" -eq 1 ]] && setup_args+=("--persist-loopback")
        fi
        [[ "${WITH_VULKAN_RUNTIME}" -eq 1 ]] && setup_args+=("--vulkan-runtime")
        [[ "${WITH_MESA_VULKAN}" -eq 1 ]] && setup_args+=("--mesa-vulkan")
        [[ "${WITH_SHADER_TOOLS}" -eq 1 ]] && setup_args+=("--shader-tools")
        [[ "${YES}" -eq 1 ]] && setup_args+=("--yes")
        add_plan_command "${plan_source_dir}/scripts/setup.sh" "${setup_args[@]}"
      fi
      local -a cmake_configure_args=(-S "${plan_source_dir}" -B "${BUILD_DIR}" -G Ninja -DCMAKE_BUILD_TYPE="${BUILD_TYPE}")
      if [[ "${OPEN_BACKENDS}" -eq 1 && "$(uname -s 2>/dev/null || true)" == "Linux" ]]; then
        cmake_configure_args+=(-DSTUDIOCAST_ENABLE_OPEN_CUDA=ON -DSTUDIOCAST_ENABLE_OPEN_AUDIO=ON)
      fi
      if [[ "${OPEN_VULKAN}" -eq 1 && "$(uname -s 2>/dev/null || true)" == "Linux" ]]; then
        cmake_configure_args+=(-DSTUDIOCAST_ENABLE_OPEN_VULKAN=ON)
      fi
      add_plan_command cmake "${cmake_configure_args[@]}"
      add_plan_command cmake --build "${BUILD_DIR}" --target "${BUILD_TARGETS[@]}"
      local -a install_args=("user-service" "--build-dir" "${BUILD_DIR}" "--yes")
      [[ "${WITH_SERVICE}" -ne 1 ]] && install_args+=("--link-bins-only")
      add_plan_command "${plan_source_dir}/scripts/install.sh" "${install_args[@]}"
      if [[ "${WITH_MODELS}" -eq 1 ]]; then
        local -a audio_model_args=("open-audio-models")
        local audio_model_id
        for audio_model_id in "${DEFAULT_OPEN_AUDIO_MODEL_IDS[@]}"; do
          audio_model_args+=("--model" "${audio_model_id}")
        done
        add_plan_command "${plan_source_dir}/scripts/install.sh" "${audio_model_args[@]}"

        local -a video_model_args=("open-video-models")
        local video_model_id
        for video_model_id in "${DEFAULT_OPEN_VIDEO_MODEL_IDS[@]}"; do
          video_model_args+=("--model" "${video_model_id}")
        done
        add_plan_command "${plan_source_dir}/scripts/install.sh" "${video_model_args[@]}"
      fi
      ;;
    uninstall)
      add_plan_command "${REPO_ROOT}/scripts/uninstall.sh" --yes
      ;;
    advanced)
      add_plan_command "${BACKEND_PATH}" plan install --dry-run
      add_plan_command "${BACKEND_PATH}" install --dry-run
      ;;
  esac
}

