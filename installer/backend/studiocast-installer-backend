  plan_workflow
  echo "Workflow: ${WORKFLOW}"
  echo
  echo "Summary:"
  printf '  - %s\n' "${PLAN_SUMMARY[@]}"
  echo
  echo "Changes:"
  printf '  - %s\n' "${PLAN_CHANGES[@]}"
  if [[ "${#PLAN_PRIVILEGED[@]}" -gt 0 ]]; then
    echo
    echo "Privileged operations:"
    printf '  - %s\n' "${PLAN_PRIVILEGED[@]}"
  fi
  if [[ "${#PLAN_PRESERVED[@]}" -gt 0 ]]; then
