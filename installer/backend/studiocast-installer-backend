def semver_tuple(value: str | None) -> tuple[int, int, int, tuple[Any, ...]] | None:
    if not value:
        return None
    match = re.fullmatch(r"v?(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-([0-9A-Za-z.-]+))?", value)
    if not match:
        return None
    pre: tuple[Any, ...] = ()
    if match.group(4):
        pre = tuple(int(x) if x.isdigit() else x for x in match.group(4).split("."))
    else:
        pre = (float("inf"),)
    return int(match.group(1)), int(match.group(2)), int(match.group(3)), pre


def version_relation(active: str | None, target: str | None) -> str:
    if not active:
        return "not_installed"
    a, b = semver_tuple(active), semver_tuple(target)
    if not a or not b:
        return "unknown"
    if a == b:
        return "same"
    return "upgrade" if a < b else "installed_newer"


def parse_os_release() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                values[key] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


def os_facts() -> dict[str, Any]:
    values = parse_os_release()
    os_id, version = values.get("ID", "unknown"), values.get("VERSION_ID", "")
    codename = values.get("UBUNTU_CODENAME") or values.get("VERSION_CODENAME", "")
    base_id, base_version = os_id, version
    if os_id == "linuxmint" or "ubuntu" in values.get("ID_LIKE", "").split():
        base_id = "ubuntu"
        base_version = {"jammy": "22.04", "noble": "24.04"}.get(codename, "")
        if os_id == "linuxmint" and not base_version:
            base_version = "22.04" if version.startswith("21") else "24.04" if version.startswith("22") else ""
    supported = base_id == "ubuntu" and base_version in {"22.04", "24.04"} and platform.machine() in {"x86_64", "amd64"}
    code = ("os.supported.ubuntu_jammy" if base_version == "22.04" else
            "os.supported.ubuntu_noble" if base_version == "24.04" else
            "arch.unsupported.machine" if platform.machine() not in {"x86_64", "amd64"} else
            "os.unsupported.distribution")
    return {"id": os_id, "version_id": version, "base_id": base_id,
            "base_version_id": base_version, "architecture": platform.machine(),
            "kernel_release": platform.release(), "supported": supported, "reason_codes": [code]}


def manifest_state(path: Path) -> tuple[str, dict[str, Any] | None, list[str]]:
    if not path.exists():
        return "absent", None, ["install.manifest.absent"]
    try:
        value = load_json(path)
    except BackendError as exc:
        return "unhealthy", None, ["install.manifest.corrupt", exc.code]
    schema = value.get("schema_version")
    if schema not in {1, 2}:
        return "unknown_schema", value, ["install.manifest.unknown_schema"]
    if schema == 1:
        if value.get("state") == "uninstalled":
            return "tombstone", value, ["install.manifest.healthy", "install.state.tombstone"]
        return "partial", value, ["install.manifest.legacy_v1"]
    tx_state = value.get("transaction", {}).get("state")
    if tx_state == "uninstalled":
        return "tombstone", value, ["install.manifest.healthy", "install.state.tombstone"]
    active = value.get("payloads", {}).get("active")
    if tx_state == "degraded" and active:
        return "partial", value, ["install.manifest.healthy", "install.state.degraded"]
    if not active:
        return "partial", value, ["install.payload.missing"]
    active_path = Path(active.get("path", ""))
    if not active_path.is_dir():
        return "stale", value, ["install.payload.missing"]
    return "healthy", value, ["install.manifest.healthy", "install.payload.healthy"]


def helper_facts() -> dict[str, Any]:
