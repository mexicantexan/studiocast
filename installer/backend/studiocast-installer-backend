#!/usr/bin/env bash
set -euo pipefail

# StudioCast installer backend.
#
# This script is intentionally usable without the GUI. The GUI calls it for
# detection, planning, and execution; CI/SSH/recovery users can call it directly.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
BACKEND_PATH="${SCRIPT_DIR}/studiocast-installer-backend"

APP_ID="studiocast"
SERVICE_NAME="studiocastd.service"

HOME_DIR="${HOME:-}"
if [[ -z "${HOME_DIR}" ]]; then
  echo "[installer] ERROR: HOME is not set" >&2
  exit 2
fi

XDG_DATA_HOME_DIR="${XDG_DATA_HOME:-${HOME_DIR}/.local/share}"
XDG_CONFIG_HOME_DIR="${XDG_CONFIG_HOME:-${HOME_DIR}/.config}"
XDG_STATE_HOME_DIR="${XDG_STATE_HOME:-${HOME_DIR}/.local/state}"
XDG_CACHE_HOME_DIR="${XDG_CACHE_HOME:-${HOME_DIR}/.cache}"
LOCAL_BIN_DIR="${HOME_DIR}/.local/bin"

APP_DATA_DIR="${XDG_DATA_HOME_DIR}/${APP_ID}"
APP_CONFIG_DIR="${XDG_CONFIG_HOME_DIR}/${APP_ID}"
APP_STATE_DIR="${XDG_STATE_HOME_DIR}/${APP_ID}"
APP_CACHE_DIR="${XDG_CACHE_HOME_DIR}/${APP_ID}"
MANIFEST_PATH="${APP_DATA_DIR}/install-manifest.json"
SYSTEMD_USER_DIR="${XDG_CONFIG_HOME_DIR}/systemd/user"
SERVICE_PATH="${SYSTEMD_USER_DIR}/${SERVICE_NAME}"

DEFAULT_SOURCE_DIR="${REPO_ROOT}"
DEFAULT_BUILD_DIR="${APP_CACHE_DIR}/build"
DEFAULT_BUILD_TYPE="Release"

COMMAND="help"
WORKFLOW=""
SOURCE_DIR="${DEFAULT_SOURCE_DIR}"
RELEASE_ARCHIVE=""
BUILD_DIR="${DEFAULT_BUILD_DIR}"
BUILD_TYPE="${DEFAULT_BUILD_TYPE}"

JSON_OUTPUT=0
DRY_RUN=0
YES=0
ALLOW_UNSUPPORTED=0
WITH_DEPS=1
WITH_V4L2=1
LOAD_LOOPBACK=1
PERSIST_LOOPBACK=1
WITH_SERVICE=1
WITH_MODELS=0
OPEN_BACKENDS=1
OPEN_VULKAN=0
WITH_VULKAN_RUNTIME=0
WITH_MESA_VULKAN=0
WITH_SHADER_TOOLS=0
FRESH_BUILD=0
REMOVE_USER_DATA=0
SOURCE_EXPLICIT=0
BUILD_EXPLICIT=0

EFFECTIVE_SOURCE_DIR=""
PREPARED_ARCHIVE_SOURCE_DIR=""

BINARIES=(
