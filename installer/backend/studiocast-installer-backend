usage() {
  cat <<'EOF'
StudioCast installer backend

Usage:
  installer/backend/studiocast-installer-backend <command> [workflow] [options]

Commands:
  detect-os                 Print detected OS support details.
  status                    Print installed/project status.
  plan <workflow>           Print the operations for a workflow.
  run <workflow>            Execute a workflow.
  install                   Shortcut for: run install
  update                    Shortcut for: run update
  repair                    Shortcut for: run repair
  uninstall                 Shortcut for: run uninstall
  clean-install             Shortcut for: run clean-install
  advanced                  Shortcut for: plan advanced
  manifest                  Print the current install manifest.
  help                      Show this help.

Workflows:
  install                   Install from the selected source checkout/archive.
  update                    Build/install selected source checkout/archive over the current install.
  repair                    Rebuild/reinstall from manifest paths or selected source.
  uninstall                 Remove app binaries/service/runtime artifacts.
  clean-install             Uninstall app files, then install again.
  advanced                  Show manual/backend commands without making changes.

Common options:
  --json                    Emit machine-readable JSON for detect-os/status/plan.
  --source-dir DIR          Source checkout to build from (default: this repo).
  --release-archive FILE    Source archive to extract and build from (.tar*, .tgz, .zip).
  --build-dir DIR           CMake build directory (default: ~/.cache/studiocast/build).
  --build-type TYPE         CMake build type (default: Release).
  --dry-run                 Print commands without executing them.
  -y, --yes                 Assume yes for delegated scripts.
  --allow-unsupported       Do not block execution on unsupported distro detection.

Install/update options:
  --with-deps | --skip-deps
  --v4l2loopback | --no-v4l2loopback
  --load-loopback | --no-load-loopback
  --persist-loopback | --no-persist-loopback
  --service | --no-service
  --models | --no-models    Download default Open Audio/Open Video model packs; default is off.
  --open-backends | --no-open-backends
                            Explicitly configure Open Video/Open CUDA and Open Audio support; default is on.
  --open-vulkan | --no-open-vulkan
                            Configure the optional Open Vulkan backend; default is off.
  --vulkan-runtime | --no-vulkan-runtime
                            Install optional Vulkan loader/diagnostic packages; default is off.
  --mesa-vulkan             With --vulkan-runtime, install Mesa Intel/AMD Vulkan ICDs.
  --shader-tools            Install optional developer Vulkan shader tools.
  --fresh-build | --no-fresh-build

Uninstall/clean-install options:
  --preserve-user-data      Preserve config, models, logs, cache (default).
  --remove-user-data        Also delete XDG StudioCast data/config/state/cache.

Examples:
  installer/backend/studiocast-installer-backend status --json
  installer/backend/studiocast-installer-backend plan install --json
  installer/backend/studiocast-installer-backend install --yes
  installer/backend/studiocast-installer-backend update --source-dir /tmp/StudioCast-0.3.0 --yes
  installer/backend/studiocast-installer-backend clean-install --dry-run
EOF
}

log() { echo "[installer] $*" >&2; }
die() { echo "[installer] ERROR: $*" >&2; exit 2; }

have_cmd() { command -v "$1" >/dev/null 2>&1; }

expand_path() {
  local path="$1"
  if [[ "${path}" == "~"* ]]; then
    path="${path/#~/${HOME_DIR}}"
  fi
  printf '%s\n' "${path}"
}

abs_existing_dir() {
  local path
  path="$(expand_path "$1")"
  [[ -d "${path}" ]] || die "Directory not found: ${path}"
  cd "${path}" && pwd
}

abs_existing_file() {
  local path
  path="$(expand_path "$1")"
  [[ -f "${path}" ]] || die "File not found: ${path}"
  cd "$(dirname "${path}")" && printf '%s/%s\n' "$(pwd)" "$(basename "${path}")"
}

print_cmd() {
  printf '+ '
  printf '%q ' "$@"
  printf '\n'
}

run_cmd() {
  if [[ "${DRY_RUN}" -eq 1 ]]; then
    print_cmd "$@"
    return 0
  fi
  "$@"
}

json_escape() {
  local s="${1:-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "${s}"
}

json_string() {
  printf '"'
  json_escape "${1:-}"
  printf '"'
}

json_bool() {
  if [[ "${1:-0}" == "1" || "${1:-}" == "true" ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

json_string_array() {
  local first=1
  printf '['
  local item
  for item in "$@"; do
    if [[ "${first}" -eq 0 ]]; then
      printf ','
    fi
    first=0
    json_string "${item}"
  done
  printf ']'
}

manifest_field() {
  local key="$1"
  [[ -f "${MANIFEST_PATH}" ]] || return 1
  sed -nE 's/^[[:space:]]*"'"${key}"'":[[:space:]]*"(([^"\\]|\\.)*)",?[[:space:]]*$/\1/p' \
    "${MANIFEST_PATH}" | head -n 1 | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g'
}

project_version_from() {
  local dir="$1"
  local version_file="${dir}/VERSION"
  if [[ -f "${version_file}" ]]; then
    tr -d '[:space:]' < "${version_file}"
  else
    printf 'unknown'
  fi
}

installed_binary_version() {
  local bin="${LOCAL_BIN_DIR}/studiocast"
  if [[ -x "${bin}" ]]; then
    "${bin}" --version 2>/dev/null | awk '{print $2; exit}' || true
  fi
}

read_os_release() {
  OS_ID=""
  OS_VERSION_ID=""
  OS_VERSION_CODENAME=""
  OS_UBUNTU_CODENAME=""
  OS_ID_LIKE=""
  OS_PRETTY_NAME=""

  if [[ -f /etc/os-release ]]; then
    local key value
    while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
      case "${key}" in
        ID|VERSION_ID|VERSION_CODENAME|UBUNTU_CODENAME|ID_LIKE|PRETTY_NAME)
          value="${value%\"}"
          value="${value#\"}"
          value="${value%\'}"
          value="${value#\'}"
          ;;
      esac

      case "${key}" in
        ID) OS_ID="${value}" ;;
        VERSION_ID) OS_VERSION_ID="${value}" ;;
        VERSION_CODENAME) OS_VERSION_CODENAME="${value}" ;;
        UBUNTU_CODENAME) OS_UBUNTU_CODENAME="${value}" ;;
        ID_LIKE) OS_ID_LIKE="${value}" ;;
        PRETTY_NAME) OS_PRETTY_NAME="${value}" ;;
      esac
    done < /etc/os-release
  fi

  OS_BASE_ID=""
  OS_BASE_VERSION_ID=""
  OS_BASE_CODENAME=""
  OS_MAPPING_NOTE=""
  OS_SUPPORTED=0
  OS_SUPPORT_REASON=""

  local id_like_padded=" ${OS_ID_LIKE} "
  if [[ "${OS_ID}" == "ubuntu" ]]; then
    OS_BASE_ID="ubuntu"
    OS_BASE_VERSION_ID="${OS_VERSION_ID}"
    OS_BASE_CODENAME="${OS_VERSION_CODENAME}"
    OS_MAPPING_NOTE="Native Ubuntu release."
  elif [[ "${OS_ID}" == "linuxmint" ]]; then
    OS_BASE_ID="ubuntu"
    if [[ "${OS_UBUNTU_CODENAME}" == "jammy" ]]; then
      OS_BASE_VERSION_ID="22.04"
      OS_BASE_CODENAME="jammy"
      OS_MAPPING_NOTE="Linux Mint mapped through UBUNTU_CODENAME=jammy (Ubuntu 22.04 base)."
    elif [[ "${OS_UBUNTU_CODENAME}" == "noble" ]]; then
      OS_BASE_VERSION_ID="24.04"
      OS_BASE_CODENAME="noble"
      OS_MAPPING_NOTE="Linux Mint mapped through UBUNTU_CODENAME=noble (Ubuntu 24.04 base)."
    elif [[ "${OS_VERSION_ID}" == 21* ]]; then
      OS_BASE_VERSION_ID="22.04"
      OS_BASE_CODENAME="jammy"
      OS_MAPPING_NOTE="Linux Mint ${OS_VERSION_ID} mapped to Ubuntu 22.04 base by Mint major version."
    elif [[ "${OS_VERSION_ID}" == 22* ]]; then
      OS_BASE_VERSION_ID="24.04"
      OS_BASE_CODENAME="noble"
      OS_MAPPING_NOTE="Linux Mint ${OS_VERSION_ID} mapped to Ubuntu 24.04 base by Mint major version."
    else
      OS_MAPPING_NOTE="Linux Mint detected, but Ubuntu base could not be mapped reliably."
    fi
  elif [[ "${id_like_padded}" == *" ubuntu "* && -n "${OS_UBUNTU_CODENAME}" ]]; then
    OS_BASE_ID="ubuntu"
    OS_BASE_CODENAME="${OS_UBUNTU_CODENAME}"
    case "${OS_UBUNTU_CODENAME}" in
      jammy) OS_BASE_VERSION_ID="22.04" ;;
      noble) OS_BASE_VERSION_ID="24.04" ;;
      *) OS_BASE_VERSION_ID="" ;;
    esac
    OS_MAPPING_NOTE="Ubuntu-family distro mapped through UBUNTU_CODENAME=${OS_UBUNTU_CODENAME}."
  fi

  if [[ "${OS_BASE_ID}" == "ubuntu" ]]; then
    case "${OS_BASE_VERSION_ID}:${OS_BASE_CODENAME}" in
      22.04:*|*:jammy)
        OS_SUPPORTED=1
        OS_SUPPORT_REASON="Supported Ubuntu 22.04/Jammy base."
        ;;
      24.04:*|*:noble)
        OS_SUPPORTED=1
        OS_SUPPORT_REASON="Supported Ubuntu 24.04/Noble base."
        ;;
      *)
        OS_SUPPORT_REASON="Detected Ubuntu-family system, but only Ubuntu 22.04/Jammy and 24.04/Noble bases are supported by the installer."
        ;;
    esac
  else
    OS_SUPPORT_REASON="Unsupported distro for the GUI installer backend. Manual source builds may still work; see docs/SETUP.md."
  fi
}

print_os_human() {
  read_os_release
  cat <<EOF
Detected OS: ${OS_PRETTY_NAME:-unknown}
ID: ${OS_ID:-unknown}
VERSION_ID: ${OS_VERSION_ID:-unknown}
VERSION_CODENAME: ${OS_VERSION_CODENAME:-unknown}
UBUNTU_CODENAME: ${OS_UBUNTU_CODENAME:-unknown}
ID_LIKE: ${OS_ID_LIKE:-unknown}
Ubuntu base: ${OS_BASE_VERSION_ID:-unknown} (${OS_BASE_CODENAME:-unknown})
Supported: $([[ "${OS_SUPPORTED}" -eq 1 ]] && echo yes || echo no)
Reason: ${OS_SUPPORT_REASON}
