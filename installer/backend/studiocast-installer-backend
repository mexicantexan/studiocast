#!/usr/bin/env python3
"""Stable executable entrypoint for the packaged StudioCast installer backend."""

from __future__ import annotations

import json
import sys

from studiocast_installer_backend.cli import main
from studiocast_installer_backend.contracts import BackendError


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BackendError as exc:
        print(json.dumps({"state": "failed", "error": {"code": exc.code, "message": exc.message, "details": exc.details},
                          "exit": {"kind": "backend_result", "code": 2, "signal": None}}, sort_keys=True), file=sys.stderr)
        raise SystemExit(2)
