ensure_supported_os() {
  read_os_release
  if [[ "${OS_SUPPORTED}" -ne 1 && "${ALLOW_UNSUPPORTED}" -ne 1 ]]; then
    cat >&2 <<EOF
[installer] Unsupported OS for the GUI installer backend.
[installer] Detected: ${OS_PRETTY_NAME:-unknown}
[installer] ID=${OS_ID:-unknown} VERSION_ID=${OS_VERSION_ID:-unknown} VERSION_CODENAME=${OS_VERSION_CODENAME:-unknown} UBUNTU_CODENAME=${OS_UBUNTU_CODENAME:-unknown} ID_LIKE=${OS_ID_LIKE:-unknown}
[installer] Reason: ${OS_SUPPORT_REASON}
[installer] Manual source-build instructions: docs/SETUP.md
[installer] To proceed anyway: --allow-unsupported
EOF
    exit 2
  fi
}

find_extracted_source_root() {
  local root="$1"
  if [[ -f "${root}/CMakeLists.txt" && -f "${root}/VERSION" ]]; then
    printf '%s\n' "${root}"
    return 0
  fi
  local found
  found="$(find "${root}" -maxdepth 3 -type f -name CMakeLists.txt -print | head -n 1 || true)"
  if [[ -n "${found}" && -f "$(dirname "${found}")/VERSION" ]]; then
    dirname "${found}"
    return 0
  fi
  return 1
}

prepare_source() {
  if [[ -n "${RELEASE_ARCHIVE}" ]]; then
    local stamp archive_base extract_root
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archive_base="$(basename "${RELEASE_ARCHIVE}")"
    archive_base="${archive_base//[^A-Za-z0-9._-]/_}"
    extract_root="${APP_CACHE_DIR}/sources/${stamp}-${archive_base}"
    PREPARED_ARCHIVE_SOURCE_DIR="${extract_root}"

    if [[ "${DRY_RUN}" -eq 1 ]]; then
      log "Would extract release archive: ${RELEASE_ARCHIVE} -> ${extract_root}"
      EFFECTIVE_SOURCE_DIR="${extract_root}"
      return 0
    fi

    mkdir -p "${extract_root}"
    case "${RELEASE_ARCHIVE}" in
      *.zip)
        have_cmd unzip || die "unzip is required to extract ${RELEASE_ARCHIVE}"
        unzip -q "${RELEASE_ARCHIVE}" -d "${extract_root}"
        ;;
      *.tar|*.tar.gz|*.tgz|*.tar.xz|*.txz|*.tar.bz2|*.tbz2)
        have_cmd tar || die "tar is required to extract ${RELEASE_ARCHIVE}"
        tar -xf "${RELEASE_ARCHIVE}" -C "${extract_root}"
        ;;
      *)
        die "Unsupported release archive type: ${RELEASE_ARCHIVE}"
        ;;
    esac

    EFFECTIVE_SOURCE_DIR="$(find_extracted_source_root "${extract_root}")" ||
      die "Could not find StudioCast source root inside ${RELEASE_ARCHIVE}"
  else
    EFFECTIVE_SOURCE_DIR="${SOURCE_DIR}"
  fi

  [[ -f "${EFFECTIVE_SOURCE_DIR}/CMakeLists.txt" ]] || die "Source dir missing CMakeLists.txt: ${EFFECTIVE_SOURCE_DIR}"
  [[ -f "${EFFECTIVE_SOURCE_DIR}/VERSION" ]] || die "Source dir missing VERSION: ${EFFECTIVE_SOURCE_DIR}"
  [[ -x "${EFFECTIVE_SOURCE_DIR}/scripts/setup.sh" ]] || die "Source dir missing executable scripts/setup.sh: ${EFFECTIVE_SOURCE_DIR}"
  [[ -x "${EFFECTIVE_SOURCE_DIR}/scripts/install.sh" ]] || die "Source dir missing executable scripts/install.sh: ${EFFECTIVE_SOURCE_DIR}"
}

run_setup_deps() {
  if [[ "${WITH_DEPS}" -ne 1 && "${WITH_VULKAN_RUNTIME}" -ne 1 && "${WITH_SHADER_TOOLS}" -ne 1 ]]; then
    return 0
  fi
  local -a args=()
  [[ "${WITH_DEPS}" -eq 1 ]] && args+=("--deps")
  if [[ "${WITH_V4L2}" -eq 1 ]]; then
    args+=("--v4l2loopback")
    [[ "${LOAD_LOOPBACK}" -eq 1 ]] && args+=("--load-loopback")
    [[ "${PERSIST_LOOPBACK}" -eq 1 ]] && args+=("--persist-loopback")
  fi
  [[ "${WITH_VULKAN_RUNTIME}" -eq 1 ]] && args+=("--vulkan-runtime")
  [[ "${WITH_MESA_VULKAN}" -eq 1 ]] && args+=("--mesa-vulkan")
  [[ "${WITH_SHADER_TOOLS}" -eq 1 ]] && args+=("--shader-tools")
  [[ "${YES}" -eq 1 ]] && args+=("--yes")
  log "Installing/checking selected dependencies through scripts/setup.sh"
  run_cmd "${EFFECTIVE_SOURCE_DIR}/scripts/setup.sh" "${args[@]}"
}

configure_build() {
  if [[ "${FRESH_BUILD}" -eq 1 && -e "${BUILD_DIR}" ]]; then
    case "${BUILD_DIR}" in
      "${HOME_DIR}/"*|"${APP_CACHE_DIR}"/*|"${EFFECTIVE_SOURCE_DIR}/build"|\
      "${EFFECTIVE_SOURCE_DIR}/cmake-build-debug"|"${EFFECTIVE_SOURCE_DIR}/cmake-build-release")
        log "Removing build directory for fresh build: ${BUILD_DIR}"
        run_cmd rm -rf -- "${BUILD_DIR}"
        ;;
      *)
        die "Refusing to remove non-user/non-standard build dir for --fresh-build: ${BUILD_DIR}"
        ;;
    esac
  fi

  log "Configuring CMake build: ${BUILD_DIR}"
  run_cmd mkdir -p -- "$(dirname "${BUILD_DIR}")"
  local -a cmake_configure_args=(-S "${EFFECTIVE_SOURCE_DIR}" -B "${BUILD_DIR}" -G Ninja -DCMAKE_BUILD_TYPE="${BUILD_TYPE}")
  if [[ "${OPEN_BACKENDS}" -eq 1 && "$(uname -s 2>/dev/null || true)" == "Linux" ]]; then
    cmake_configure_args+=(-DSTUDIOCAST_ENABLE_OPEN_CUDA=ON -DSTUDIOCAST_ENABLE_OPEN_AUDIO=ON)
  fi
  if [[ "${OPEN_VULKAN}" -eq 1 && "$(uname -s 2>/dev/null || true)" == "Linux" ]]; then
    cmake_configure_args+=(-DSTUDIOCAST_ENABLE_OPEN_VULKAN=ON)
  fi
  run_cmd cmake "${cmake_configure_args[@]}"
}

build_studiocast() {
  log "Building StudioCast targets"
  run_cmd cmake --build "${BUILD_DIR}" --target "${BUILD_TARGETS[@]}"
}

install_binaries_and_service() {
  local -a args=("user-service" "--build-dir" "${BUILD_DIR}" "--yes")
  if [[ "${WITH_SERVICE}" -ne 1 ]]; then
    args+=("--link-bins-only")
  fi
  log "Installing StudioCast binaries$([[ "${WITH_SERVICE}" -eq 1 ]] && echo " and user service" || echo "")"
  run_cmd "${EFFECTIVE_SOURCE_DIR}/scripts/install.sh" "${args[@]}"
}

install_models_if_requested() {
  [[ "${WITH_MODELS}" -eq 1 ]] || return 0
  log "Installing default Open Audio and Open Video model packs"

  local -a audio_args=("open-audio-models")
  local audio_model_id
  for audio_model_id in "${DEFAULT_OPEN_AUDIO_MODEL_IDS[@]}"; do
    audio_args+=("--model" "${audio_model_id}")
  done

  local -a video_args=("open-video-models")
  local video_model_id
  for video_model_id in "${DEFAULT_OPEN_VIDEO_MODEL_IDS[@]}"; do
    video_args+=("--model" "${video_model_id}")
  done

  run_cmd "${EFFECTIVE_SOURCE_DIR}/scripts/install.sh" "${audio_args[@]}"
  run_cmd "${EFFECTIVE_SOURCE_DIR}/scripts/install.sh" "${video_args[@]}"
}

configure_daemon_defaults() {
  local conf="${APP_CONFIG_DIR}/daemon.conf"
  log "Ensuring daemon CPU resize fallback is enabled by default"

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    print_cmd mkdir -p -- "${APP_CONFIG_DIR}"
    printf '+ ensure-daemon-config %q %q\n' "${conf}" "video.scaling.allow_cpu_resize=true"
    return 0
  fi

  mkdir -p -- "${APP_CONFIG_DIR}"
  if [[ ! -f "${conf}" ]]; then
    {
      printf '# StudioCast daemon (studiocastd) configuration\n'
      printf '# This file is managed by the StudioCast GUI / studiocastctl.\n\n'
      printf 'video.scaling.allow_cpu_resize = true\n'
    } > "${conf}"
    return 0
  fi

  local tmp="${conf}.tmp"
  awk '
    BEGIN { done = 0 }
    /^[[:space:]]*video[.]scaling[.]allow_cpu_resize[[:space:]]*=/ {
      print "video.scaling.allow_cpu_resize = true"
      done = 1
      next
    }
    { print }
    END {
      if (!done) {
        print ""
        print "video.scaling.allow_cpu_resize = true"
      }
    }
  ' "${conf}" > "${tmp}"
  mv -- "${tmp}" "${conf}"
}

write_manifest() {
  local state="$1"
  local version="$2"
  local dependency_method=""
  [[ "${WITH_DEPS}" -eq 1 ]] && dependency_method="scripts/setup.sh --deps"
  [[ "${WITH_V4L2}" -eq 1 ]] && dependency_method="${dependency_method:+${dependency_method} + }v4l2loopback"
  [[ "${WITH_VULKAN_RUNTIME}" -eq 1 ]] && dependency_method="${dependency_method:+${dependency_method} + }optional Vulkan runtime"
  [[ "${WITH_MESA_VULKAN}" -eq 1 ]] && dependency_method="${dependency_method:+${dependency_method} + }Mesa Intel/AMD Vulkan ICDs"
  [[ "${WITH_SHADER_TOOLS}" -eq 1 ]] && dependency_method="${dependency_method:+${dependency_method} + }Vulkan shader tools"
  [[ -n "${dependency_method}" ]] || dependency_method="skipped"

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "Would write manifest: ${MANIFEST_PATH}"
    return 0
  fi

  mkdir -p "${APP_DATA_DIR}"
  local tmp="${MANIFEST_PATH}.tmp"
  local timestamp active enabled
  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  active="$(service_state_value is-active)"
  enabled="$(service_state_value is-enabled)"

  {
    printf '{\n'
    printf '  "schema_version": 1,\n'
    printf '  "state": '; json_string "${state}"; printf ',\n'
    printf '  "installed_version": '; json_string "${version}"; printf ',\n'
    printf '  "source_path": '; json_string "${EFFECTIVE_SOURCE_DIR:-${SOURCE_DIR}}"; printf ',\n'
    printf '  "build_path": '; json_string "${BUILD_DIR}"; printf ',\n'
    printf '  "install_paths": {\n'
    printf '    "local_bin_dir": '; json_string "${LOCAL_BIN_DIR}"; printf ',\n'
    printf '    "manifest_path": '; json_string "${MANIFEST_PATH}"; printf ',\n'
    printf '    "service_path": '; json_string "${SERVICE_PATH}"; printf '\n'
    printf '  },\n'
    printf '  "binaries": [\n'
    local first=1 b path
    for b in "${BINARIES[@]}"; do
      path="${LOCAL_BIN_DIR}/${b}"
      if [[ "${first}" -eq 0 ]]; then
        printf ',\n'
      fi
      first=0
      printf '    {"name": '; json_string "${b}"; printf ', "path": '; json_string "${path}"; printf ', "exists": '; json_bool "$([[ -e "${path}" || -L "${path}" ]] && echo 1 || echo 0)"; printf '}'
    done
    printf '\n  ],\n'
    printf '  "user_service": {\n'
    printf '    "name": '; json_string "${SERVICE_NAME}"; printf ',\n'
    printf '    "path": '; json_string "${SERVICE_PATH}"; printf ',\n'
    printf '    "installed": '; json_bool "$([[ -f "${SERVICE_PATH}" ]] && echo 1 || echo 0)"; printf ',\n'
    printf '    "active": '; json_string "${active}"; printf ',\n'
    printf '    "enabled": '; json_string "${enabled}"; printf '\n'
    printf '  },\n'
    printf '  "dependency_install_method": '; json_string "${dependency_method}"; printf ',\n'
    printf '  "installed_at": '; json_string "${timestamp}"; printf ',\n'
    printf '  "user_data": {\n'
    printf '    "config_preserved": '; json_bool "$([[ "${REMOVE_USER_DATA}" -eq 0 ]] && echo 1 || echo 0)"; printf ',\n'
    printf '    "models_preserved": '; json_bool "$([[ "${REMOVE_USER_DATA}" -eq 0 ]] && echo 1 || echo 0)"; printf ',\n'
    printf '    "logs_preserved": '; json_bool "$([[ "${REMOVE_USER_DATA}" -eq 0 ]] && echo 1 || echo 0)"; printf ',\n'
    printf '    "cache_preserved": '; json_bool "$([[ "${REMOVE_USER_DATA}" -eq 0 ]] && echo 1 || echo 0)"; printf '\n'
    printf '  }\n'
    printf '}\n'
  } > "${tmp}"
  mv -- "${tmp}" "${MANIFEST_PATH}"
}

remove_user_data_dirs() {
  [[ "${REMOVE_USER_DATA}" -eq 1 ]] || return 0
  log "Removing StudioCast user data/config/state/cache"
  local p
  for p in "${APP_CONFIG_DIR}" "${APP_DATA_DIR}" "${APP_STATE_DIR}" "${APP_CACHE_DIR}"; do
    [[ -n "${p}" && "${p}" != "/" ]] || die "Refusing to remove unsafe path: ${p}"
    if [[ -e "${p}" || -L "${p}" ]]; then
      run_cmd rm -rf -- "${p}"
    fi
  done
}

run_uninstall_workflow() {
  local previous_version
  previous_version="$(manifest_field installed_version 2>/dev/null || true)"
  log "Uninstalling StudioCast app files"
  run_cmd "${REPO_ROOT}/scripts/uninstall.sh" --yes
  remove_user_data_dirs

  if [[ "${REMOVE_USER_DATA}" -eq 0 ]]; then
    EFFECTIVE_SOURCE_DIR="$(manifest_field source_path 2>/dev/null || printf '%s' "${SOURCE_DIR}")"
    write_manifest "uninstalled" "${previous_version:-unknown}"
  fi
}

run_install_like_workflow() {
  ensure_supported_os
  prepare_source
  run_setup_deps
  configure_build
  build_studiocast
  configure_daemon_defaults
  install_binaries_and_service
  install_models_if_requested

  local version state
  version="$(project_version_from "${EFFECTIVE_SOURCE_DIR}")"
  state="${WORKFLOW}"
  [[ "${state}" == "install" ]] && state="installed"
  [[ "${state}" == "clean-install" ]] && state="clean-installed"
  write_manifest "${state}" "${version}"
}

run_workflow() {
  case "${WORKFLOW}" in
    install|update)
      run_install_like_workflow
      ;;
    repair)
      if [[ "${SOURCE_EXPLICIT}" -eq 0 && -z "${RELEASE_ARCHIVE}" ]]; then
        local manifest_source
        manifest_source="$(manifest_field source_path 2>/dev/null || true)"
        if [[ -n "${manifest_source}" && -d "${manifest_source}" ]]; then
          SOURCE_DIR="${manifest_source}"
        fi
      fi
      if [[ "${BUILD_EXPLICIT}" -eq 0 ]]; then
        local manifest_build
        manifest_build="$(manifest_field build_path 2>/dev/null || true)"
        if [[ -n "${manifest_build}" ]]; then
          BUILD_DIR="${manifest_build}"
        fi
      fi
      run_install_like_workflow
      ;;
    uninstall)
      run_uninstall_workflow
      ;;
    clean-install)
      FRESH_BUILD=1
      run_uninstall_workflow
      run_install_like_workflow
      ;;
    advanced)
      print_plan_human
      ;;
    *)
      die "Unknown workflow: ${WORKFLOW}"
      ;;
  esac
}

parse_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) JSON_OUTPUT=1; shift ;;
      --source-dir)
        [[ $# -ge 2 ]] || die "--source-dir requires a path"
        SOURCE_DIR="$(abs_existing_dir "$2")"
        SOURCE_EXPLICIT=1
        shift 2
        ;;
      --release-archive)
        [[ $# -ge 2 ]] || die "--release-archive requires a file"
        RELEASE_ARCHIVE="$(abs_existing_file "$2")"
        shift 2
        ;;
      --build-dir)
        [[ $# -ge 2 ]] || die "--build-dir requires a path"
        BUILD_DIR="$(expand_path "$2")"
        BUILD_EXPLICIT=1
        shift 2
        ;;
      --build-type)
        [[ $# -ge 2 ]] || die "--build-type requires a value"
        BUILD_TYPE="$2"
        shift 2
        ;;
      --dry-run) DRY_RUN=1; shift ;;
      -y|--yes) YES=1; shift ;;
      --allow-unsupported) ALLOW_UNSUPPORTED=1; shift ;;
      --with-deps) WITH_DEPS=1; shift ;;
      --skip-deps) WITH_DEPS=0; shift ;;
      --v4l2loopback) WITH_V4L2=1; shift ;;
      --no-v4l2loopback) WITH_V4L2=0; LOAD_LOOPBACK=0; PERSIST_LOOPBACK=0; shift ;;
      --load-loopback) LOAD_LOOPBACK=1; shift ;;
      --no-load-loopback) LOAD_LOOPBACK=0; shift ;;
      --persist-loopback) PERSIST_LOOPBACK=1; shift ;;
      --no-persist-loopback) PERSIST_LOOPBACK=0; shift ;;
      --service) WITH_SERVICE=1; shift ;;
      --no-service) WITH_SERVICE=0; shift ;;
      --models) WITH_MODELS=1; shift ;;
      --no-models) WITH_MODELS=0; shift ;;
      --open-backends) OPEN_BACKENDS=1; shift ;;
      --no-open-backends) OPEN_BACKENDS=0; shift ;;
      --open-vulkan) OPEN_VULKAN=1; shift ;;
      --no-open-vulkan) OPEN_VULKAN=0; shift ;;
      --vulkan-runtime) WITH_VULKAN_RUNTIME=1; shift ;;
      --no-vulkan-runtime) WITH_VULKAN_RUNTIME=0; WITH_MESA_VULKAN=0; shift ;;
      --mesa-vulkan) WITH_VULKAN_RUNTIME=1; WITH_MESA_VULKAN=1; shift ;;
      --shader-tools) WITH_SHADER_TOOLS=1; shift ;;
      --fresh-build) FRESH_BUILD=1; shift ;;
      --no-fresh-build) FRESH_BUILD=0; shift ;;
      --preserve-user-data) REMOVE_USER_DATA=0; shift ;;
      --remove-user-data) REMOVE_USER_DATA=1; shift ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

main() {
  COMMAND="${1:-help}"
  shift || true

  case "${COMMAND}" in
    help|-h|--help)
      usage
      exit 0
      ;;
    detect-os|status|manifest)
      parse_options "$@"
      ;;
    plan)
      WORKFLOW="${1:-install}"
      if [[ $# -gt 0 && "${1}" != --* ]]; then
        shift
      fi
      parse_options "$@"
      ;;
    run)
      WORKFLOW="${1:-install}"
      if [[ $# -gt 0 && "${1}" != --* ]]; then
        shift
      fi
      parse_options "$@"
      ;;
    install|update|repair|uninstall|clean-install)
      WORKFLOW="${COMMAND}"
      COMMAND="run"
      parse_options "$@"
      ;;
    advanced)
      WORKFLOW="advanced"
      COMMAND="plan"
      parse_options "$@"
      ;;
    *)
      die "Unknown command: ${COMMAND}"
      ;;
  esac

  if [[ -n "${RELEASE_ARCHIVE}" && "${SOURCE_EXPLICIT}" -eq 1 ]]; then
    die "Use either --source-dir or --release-archive, not both."
  fi

  case "${COMMAND}" in
    detect-os)
      if [[ "${JSON_OUTPUT}" -eq 1 ]]; then print_os_json; else print_os_human; fi
      ;;
    status)
      if [[ "${JSON_OUTPUT}" -eq 1 ]]; then print_status_json; else print_status_human; fi
      ;;
    manifest)
      if [[ -f "${MANIFEST_PATH}" ]]; then
        cat "${MANIFEST_PATH}"
      else
        die "Install manifest not found: ${MANIFEST_PATH}"
      fi
      ;;
    plan)
      if [[ "${JSON_OUTPUT}" -eq 1 ]]; then print_plan_json; else print_plan_human; fi
      ;;
    run)
      run_workflow
      ;;
  esac
}

main "$@"
